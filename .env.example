# JFL Solar — environment variables
# Copy to .env.local for local development. Set the same names in Vercel
# (Project → Settings → Environment Variables), with DIFFERENT values for
# Preview and Production. Never commit real values.

# --- Site -------------------------------------------------------------------
# "production" only on the live jflsolar.com deployment. Anything else (or unset)
# = proposal/preview mode: noindex, robots disallow-all, sample content shown
# with labels, "Proposal preview" ribbon.
SITE_ENV=preview
# Canonical site URL (no trailing slash). Production: https://jflsolar.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
# Leave both unset to run the public site on bundled demo content (admin disabled).
NEXT_PUBLIC_SUPABASE_URL=
# Public "publishable" key (or legacy anon key in NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret key (or legacy service_role key). Used only for the inquiry
# rate limiter and `npm run admin:grant` / `npm run launch:check`.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Inquiry delivery (Resend, https://resend.com) ---------------------------
# While any of these three is unset the contact form runs in DEMO mode: it
# validates input, clearly says it is a demo, and sends nothing.
RESEND_API_KEY=
# Business inbox that receives inquiries (comma-separate several). NOT shown publicly.
# Placeholder agreed with the owner: info@jflsolar.com (confirm the mailbox exists first).
INQUIRY_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "JFL Solar Website <inquiries@jflsolar.com>"
INQUIRY_FROM_EMAIL=
# 32+ random characters (e.g. `openssl rand -base64 48`). Required for live delivery.
INQUIRY_SIGNING_SECRET=
# Max inquiries accepted per rolling 24 h across the whole site (Resend free tier = 100/day).
INQUIRY_DAILY_CAP=80
